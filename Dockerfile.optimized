FROM dunglas/frankenphp:latest-php8.3

WORKDIR /app

# Install PHP extensions - CRITICAL FOR PERFORMANCE
# opcache: PHP bytecode caching (5-10x speedup)
# bcmath: Faster bcrypt hashing
# redis: For caching support
# intl: Laravel internationalization
# curl: HTTP requests
RUN install-php-extensions \
    opcache \
    gd \
    zip \
    pdo_mysql \
    bcmath \
    curl \
    intl

# Instalar Composer desde la imagen oficial
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Copiar solo los archivos de dependencias primero (para caché de Docker)
COPY composer.json composer.lock* ./

# Instalar dependencias (incluyendo dev para desarrollo)
# Nota: Removed --ignore-platform-reqs to ensure extensions are properly installed
RUN composer install --no-interaction --prefer-dist

# Copiar el resto del código
COPY . .

# Establecer permisos correctos
RUN chown -R www-data:www-data /app/storage /app/bootstrap/cache && \
    chmod -R 775 /app/storage /app/bootstrap/cache

# Create PHP.ini configuration for performance optimization
RUN echo "[opcache]\n\
opcache.enable=1\n\
opcache.memory_consumption=256\n\
opcache.interned_strings_buffer=16\n\
opcache.max_accelerated_files=20000\n\
opcache.max_wasted_percentage=10\n\
opcache.consistency_checks=0\n\
opcache.revalidate_freq=0\n\
opcache.enable_cli=1\n\
\n\
[PHP]\n\
memory_limit=512M\n\
max_execution_time=300\n\
upload_max_filesize=100M\n\
post_max_size=100M\n\
realpath_cache_size=4096K\n\
realpath_cache_ttl=600\n\
\n\
[Xdebug]\n\
; Disable xdebug by default for performance\n\
xdebug.mode=off\n\
" > /usr/local/etc/php/conf.d/php-performance.ini

EXPOSE 80 443

CMD ["frankenphp", "php-server", "--root", "/app/public"]
